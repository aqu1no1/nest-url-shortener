# Copie para .env.test. Usado quando NODE_ENV=test (Vitest define isso por padrão).
# O banco de testes roda no docker-compose.test.yml, isolado do banco de desenvolvimento.
NODE_ENV=test
PORT=3001

# Usadas pelo docker-compose.test.yml. A DATABASE_URL abaixo precisa refletir esses valores.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener_test
POSTGRES_PORT=5433

# Base dos bancos por worker: os testes usam url_shortener_test_1 ... url_shortener_test_4.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/url_shortener_test
SWAGGER_ENABLED=false
