{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": ["pnpm-lock.yaml", "dist", "coverage", "src/generated", "prisma/migrations"],
  "sortImports": {
    "internalPattern": ["@/", "@test/"],
    "newlinesBetween": false
  }
}
