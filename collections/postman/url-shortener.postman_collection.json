{
  "info": {
    "name": "URL Shortener",
    "description": "API nest-url-shortener (roadmap.sh URL Shortening Service). Use o environment `local`. Rode as requisições de `URLs` em ordem: `Criar URL` salva o `shortCode` usado pelas demais. Troque `lang` para `en` para mensagens em inglês.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "URLs",
      "item": [
        {
          "name": "Criar URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept-Language",
                "value": "{{lang}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shorten",
              "host": ["{{baseUrl}}"],
              "path": ["shorten"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.example.com/some/long/url\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Encurta uma URL e salva o `shortCode` na variável de ambiente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const created = pm.response.json().data;",
                  "pm.test('retorna { data } com shortCode', () => pm.expect(created.shortCode).to.match(/^[0-9A-Za-z]{6}$/));",
                  "pm.environment.set('shortCode', created.shortCode);"
                ]
              }
            }
          ],
          "response": [
