# Copie para .env e ajuste os valores. Nunca versione o .env.
NODE_ENV=development
PORT=3000

# Usadas pelo docker-compose.yml. A DATABASE_URL abaixo precisa refletir esses valores.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=url_shortener
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/url_shortener
SWAGGER_ENABLED=true
